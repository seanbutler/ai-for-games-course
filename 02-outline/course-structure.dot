    // ── Learning Outcome nodes ───────────────────────────────────────────
    node [shape=box width=3.5 style=filled fillcolor="#EEFFEE" fontcolor="Black" fontname="Helvetica" fontsize=10]


    lo1 [label="LO1 — Critically analyse\ntraditional game AI"]
    lo2 [label="LO2 — Evaluate and compare\nAI approaches"]
    lo3 [label="LO3 — Design and implement\nclassical algorithms"]
    lo4 [label="LO4 — Conceptual understanding\nof modern ML"]
    lo5 [label="LO5 — Apply neural network\nsolutions"]
    lo6 [label="LO6 — Critically assess\nmodern AI in games"]

    { rank = same; lo1; lo2; lo3; lo4; lo5; lo6; level4;}

    edge [style=dashed color="#2d7a4a" constraint=false]


    u01 -> lo1
